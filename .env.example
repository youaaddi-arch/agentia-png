# Copiez ce fichier en ".env" et renseignez votre clé.

# --- Fournisseur d'IA par défaut : Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé par les agents (format "fournisseur:modele").
# Défaut : anthropic:claude-sonnet-4-6
AGENTIA_MODEL=anthropic:claude-sonnet-4-6

# --- Pour utiliser OpenAI à la place (optionnel) ---
# OPENAI_API_KEY=sk-...
# AGENTIA_MODEL=openai:gpt-4o-mini
