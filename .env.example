# Copiez ce fichier en ".env" et renseignez vos clés.

# Clé API du fournisseur LLM (OpenAI par défaut)
OPENAI_API_KEY=sk-...

# Modèle utilisé par les agents (optionnel, défaut : gpt-4o-mini)
AGENTIA_MODEL=gpt-4o-mini

# --- Autres fournisseurs supportés par CrewAI (optionnel) ---
# ANTHROPIC_API_KEY=...
# GROQ_API_KEY=...
# Pour utiliser Claude, définissez par exemple :
# AGENTIA_MODEL=anthropic/claude-sonnet-4-6
